APP_NAME=djangodesk
APP_ENV=local
LOG_LEVEL=INFO
DATA_FILE=data/sample_records.json

# Local placeholder. Put your real Neon URL in .env only.
DATABASE_URL=postgresql://localhost:5432/djangodesk

# Local Docker PostgreSQL settings
POSTGRES_PASSWORD=YOUR_PASSOWORD
DOCKER_DATABASE_URL=YOUR_DB_API_KEY

# LLM keys (Day 8). Free keys: https://aistudio.google.com/apikey and https://console.groq.com/keys
# Real values go in .env, GitHub Secrets and Render only. Never in Git.
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_PRIMARY_MODEL=gemini-3.8-flash
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
